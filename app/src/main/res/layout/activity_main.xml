<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F4"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/screenContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/floatingFooter"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_floating_footer"
        android:elevation="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="8dp">

        <TextView
            android:id="@+id/footerAvatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_footer_avatar"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="&#9889;"
            android:textColor="#D9898D"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/footerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="AC Repair &amp; Service"
                android:textColor="#111111"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/footerSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Certified expert  |  Same-day visit"
                android:textColor="#6D6D6D"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/footerAction"
            android:layout_width="126dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_footer_action"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Book Slot&#10;No upfront pay"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/footerClose"
            android:layout_width="34dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="&#215;"
            android:textColor="#D9898D"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/supportInputDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF8F4"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="7dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Home"
            android:textColor="#D9898D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/navBookings"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Bookings"
            android:textColor="#6D6D6D"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/navAdd"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/bg_orange_circle"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/navOffers"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Offers"
            android:textColor="#6D6D6D"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Profile"
            android:textColor="#6D6D6D"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
