<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFEEEE" />
            <stroke
                android:width="1dp"
                android:color="#FFE8CFCF" />
        </shape>
    </item>

    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="#FFFFFFFF"
                android:endColor="#FFF6DADB" />
        </shape>
    </item>
</layer-list>
