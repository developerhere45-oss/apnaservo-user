<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#26D9898D" />
            <corners android:radius="30dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#FFFFFFFF"
                android:centerColor="#FFFFFBF8"
                android:endColor="#FFFFF0EF" />
            <stroke
                android:width="1dp"
                android:color="#FFE8CFCF" />
            <corners android:radius="29dp" />
        </shape>
    </item>
</layer-list>
