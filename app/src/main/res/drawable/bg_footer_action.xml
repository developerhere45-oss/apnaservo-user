<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="#FF242424"
                android:centerColor="#FF161616"
                android:endColor="#FF050505" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <solid android:color="#00FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#55FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
